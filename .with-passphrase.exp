#!/bin/expect -f

set timeout -1
spawn {*}$argv
match_max 100000

# Loop to handle multiple passphrase prompts
expect {
    "Enter key passphrase (empty if none):" {
        send -- "$env(PASSPHRASE)\r"
        exp_continue
    }
    "Enter passphrase for \"keys/id_ed25519\":" {
        send -- "$env(PASSPHRASE)\r"
        exp_continue
    }
    eof
}
