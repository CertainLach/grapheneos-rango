From abb4764bea65ffd218f3e3362d00893faa1d57b2 Mon Sep 17 00:00:00 2001
From: Lach <iam@lach.pw>
Date: Fri, 28 Nov 2025 03:18:50 +0000
Subject: [PATCH 1/4] kernelsu: add submodule, include kconfig

Signed-off-by: Lach <iam@lach.pw>
---
 drivers/Kconfig  | 1 +
 drivers/Makefile | 2 ++
 drivers/kernelsu | 1 +
 3 files changed, 4 insertions(+)
 create mode 120000 drivers/kernelsu

diff --git a/drivers/Kconfig b/drivers/Kconfig
index efb66e25fa2d..c1326a1ad4e4 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -243,4 +243,5 @@ source "drivers/hte/Kconfig"
 
 source "drivers/cdx/Kconfig"
 
+source "drivers/kernelsu/Kconfig"
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index 1bec7819a837..6685e7b2d464 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -199,3 +199,5 @@ obj-$(CONFIG_DRM_ACCEL)		+= accel/
 obj-$(CONFIG_CDX_BUS)		+= cdx/
 
 obj-$(CONFIG_S390)		+= s390/
+
+obj-$(CONFIG_KSU) += kernelsu/
diff --git a/drivers/kernelsu b/drivers/kernelsu
new file mode 120000
index 000000000000..b32a3654a683
--- /dev/null
+++ b/drivers/kernelsu
@@ -0,0 +1 @@
+../KernelSU-Next/kernel
\ No newline at end of file
-- 
2.52.0

