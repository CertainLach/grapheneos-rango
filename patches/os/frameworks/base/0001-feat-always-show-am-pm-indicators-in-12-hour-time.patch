@@ -151,7 +151,11 @@ class DigitalTimeFormatter(
 }
 
 class DigitalTimespecHandler(val timespec: DigitalTimespec, val formatter: DigitalTimeFormatter) {
-    fun getViewId(): Int = timespec.getViewId("h" in formatter.pattern)
+    fun getViewId(): Int {
+        val isAmPm = "a" in formatter.pattern && "h" !in formatter.pattern && "H" !in formatter.pattern
+        val isHour = "h" in formatter.pattern
+        return timespec.getViewId(isHour, isAmPm)
+    }
 
     fun getText(): String {
         val text = formatter.getText()
