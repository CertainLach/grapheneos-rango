@@ -136,7 +136,10 @@ class FlexClockViewGroup(clockCtx: ClockContext) :
 
         val xScale = if (childViews.size < 4) 1f else 2f
         val yBuffer = context.resources.getDimensionPixelSize(R.dimen.clock_vertical_digit_buffer)
-        return (maxChildSize + aodTranslate.abs()) * VPointF(xScale, 2f) + VPointF(0f, yBuffer)
+        // Check if we have AM/PM views to determine if we need 3 rows
+        val hasAmPm = childViews.any { it.id == ClockViewIds.AM_PM_FIRST_DIGIT || it.id == ClockViewIds.AM_PM_SECOND_DIGIT }
+        val yScale = if (hasAmPm) 3f else 2f
+        return (maxChildSize + aodTranslate.abs()) * VPointF(xScale, yScale) + VPointF(0f, yBuffer * (yScale - 1))
     }
 
     override fun onViewAdded(child: View?) {
@@ -216,6 +219,9 @@ class FlexClockViewGroup(clockCtx: ClockContext) :
                         ClockViewIds.HOUR_SECOND_DIGIT,
                         ClockViewIds.MINUTE_FIRST_DIGIT,
                         ClockViewIds.MINUTE_SECOND_DIGIT -> child.maxSize * 2f
+                        // AM/PM views are duplicated in both directions but in a 3-row layout
+                        ClockViewIds.AM_PM_FIRST_DIGIT,
+                        ClockViewIds.AM_PM_SECOND_DIGIT -> child.maxSize * VPointF(2f, 3f)
                         // Other clock view ids are not valid children
                         else -> VPointF(-1)
                     },
@@ -269,6 +275,9 @@ class FlexClockViewGroup(clockCtx: ClockContext) :
                         ClockViewIds.MINUTE_DIGIT_PAIR -> VPointF(0f, y + yBuffer)
                         ClockViewIds.MINUTE_FIRST_DIGIT -> VPointF(0f, y + yBuffer)
                         ClockViewIds.MINUTE_SECOND_DIGIT -> VPointF(x, y + yBuffer)
+                        // Add AM/PM in third row
+                        ClockViewIds.AM_PM_FIRST_DIGIT -> VPointF(0f, 2 * (y + yBuffer))
+                        ClockViewIds.AM_PM_SECOND_DIGIT -> VPointF(x, 2 * (y + yBuffer))
                         else -> VPointF.ZERO
                     }
                 }
@@ -497,6 +506,8 @@ class FlexClockViewGroup(clockCtx: ClockContext) :
                     ClockViewIds.HOUR_SECOND_DIGIT -> VPointF(1, -1)
                     ClockViewIds.MINUTE_FIRST_DIGIT -> VPointF(-1, 1)
                     ClockViewIds.MINUTE_SECOND_DIGIT -> VPointF(1, 1)
+                    ClockViewIds.AM_PM_FIRST_DIGIT -> VPointF(-1, 1)
+                    ClockViewIds.AM_PM_SECOND_DIGIT -> VPointF(1, 1)
                     ClockViewIds.HOUR_DIGIT_PAIR -> VPointF(-1, -1)
                     ClockViewIds.MINUTE_DIGIT_PAIR -> VPointF(-1, 1)
                     else -> VPointF(1, 1)
