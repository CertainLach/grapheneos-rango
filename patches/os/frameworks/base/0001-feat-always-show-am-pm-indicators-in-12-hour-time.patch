diff --git a/packages/SystemUI/customization/clocks/common/src/com/android/systemui/customization/clocks/DigitalTimespec.kt b/packages/SystemUI/customization/clocks/common/src/com/android/systemui/customization/clocks/DigitalTimespec.kt
